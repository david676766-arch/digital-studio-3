# Copy this file to .env.local (local) or add the variables in your hosting dashboard (e.g. Vercel).

# Public URL of the website — used for SEO metadata, sitemap and social previews.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ── Contact form delivery (configure at least one, otherwise the form honestly reports "not connected") ──

# Option A — Telegram bot (inquiries arrive as Telegram messages)
#   1. In Telegram, open @BotFather → /newbot → copy the token.
#   2. Send any message to your new bot, then open
#      https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id": ...}.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Option B — any webhook receiving JSON (Zapier, Make, n8n, Slack incoming webhook, CRM, email service…)
CONTACT_WEBHOOK_URL=
